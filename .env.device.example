# Device service environment overrides. Uncomment the values you want to set.
# Defaults below distinguish service configuration from standalone defaults.

# --- Player and radio services ---------------------------------------------

# Wi-Fi interface used by the daemon radio adapter. Unset = first interface
# with /sys/class/net/<name>/wireless; no such interface is an explicit error.
# TEMPO_WIFI_INTERFACE=wlan0

# flutter-pi video texture size WIDTHxHEIGHT, positive dimensions <=4096.
# Unset = no explicit size filter. The shipped tempo.service sets 480x360.
# Applies to the device GStreamer video plugin, not emulator media playback.
# TEMPO_VIDEO_SIZE=480x360

# Video diagnostic statistics: unset = off. ANY presence enables it, including
# an empty value, 0 or false. Export only for a scoped diagnostic run.
# TEMPO_VIDEO_STATS=1

# --- Daemon and frontend credentials / storage ------------------------------

# Frontend and radio-client API endpoint. Literal default below; this does not
# set the daemon's listen address/port (those are daemon command-line options).
# TEMPOD_API_URL=http://127.0.0.1:8765

# Controller credential: unset = no environment credential. The daemon requires
# --token-file or this variable. The frontend/client can use the file below.
# Production staging generates a private credential; never commit its value.
# TEMPOD_API_TOKEN=REPLACE_WITH_A_PRIVATE_CONTROLLER_CREDENTIAL

# Frontend/radio-client credential file takes precedence over TEMPOD_API_TOKEN.
# Unset = inline token fallback. Production UI drop-in sets the path below.
# The daemon itself uses --token-file, not TEMPOD_API_TOKEN_FILE.
# TEMPOD_API_TOKEN_FILE=/var/lib/tempod/credentials/api-token

# Separate local-app owner credential, required for owner publication/control.
# Unset = no environment owner credential; daemon --owner-token-file wins.
# TEMPOD_OWNER_TOKEN=REPLACE_WITH_A_DIFFERENT_PRIVATE_OWNER_CREDENTIAL

# Frontend owner file takes precedence over TEMPOD_OWNER_TOKEN. Unset = inline
# token fallback. Production UI sets this path; daemon uses --owner-token-file.
# TEMPOD_OWNER_TOKEN_FILE=/var/lib/tempod/credentials/owner-token

# Profile mode: unset = explicit database/settings paths below. Setting
# this selects the device home for .tempo data and its device-local selector.
# Production deployment sets /home/<user.name>, normally /home/tempo.
# TEMPOD_PROFILE_HOME=/home/tempo

# Frontend Unix account granted access to the selected owned profile files.
# Unset = no ownership adjustment. Production sets user.name, normally tempo.
# Does not change ownership of the media home or unrelated files.
# TEMPOD_PROFILE_USER=tempo

# SD mount root in profile mode. Literal default /mnt/sd; a directory alone does
# not count as a mounted card. Selected but absent SD remains unavailable.
# TEMPOD_SD_ROOT=/mnt/sd

# Media scan home independent of profile location. Unset = profile home, then
# HOME, then working directory. --media-home wins. SD profile location does not
# relocate the user's media folders automatically.
# TEMPOD_MEDIA_HOME=/home/tempo

# Library database when profile mode is disabled: unset = no media database.
# --media-database wins. Ignored when TEMPOD_PROFILE_HOME enables profile mode.
# TEMPOD_MEDIA_DATABASE=/home/tempo/.tempo/library.db

# Settings file when profile mode is disabled: unset = no settings owner.
# --settings-file wins. Ignored in profile mode, whose config root follows XDG.
# TEMPOD_SETTINGS_FILE=/home/tempo/.config/tempo/settings.json

# --- Native daemon and Unix control -----------------------------------------

# Runtime Unix control socket override for native broker, Dart client and
# flutter-pi handoff. Unset = compiled/configured daemon.socket; shipped value
# /run/tempod/tempod.sock. Native --socket wins; systemd activation supplies its
# own listener. TEMPOD_SOCKET is also a C compile definition for the embedder;
# exporting it at build time is not equivalent to a -DTEMPOD_SOCKET definition.
# TEMPOD_SOCKET=/run/tempod/tempod.sock

# Native metrics DB, NOT the media library. Unset = first STATE_DIRECTORY path
# plus /tempod.db, otherwise compiled daemon.state_dir plus /tempod.db.
# TEMPOD_DB=/var/lib/tempod/tempod.db

# Native metrics interval seconds: unset = compiled daemon.sample_interval,
# shipped as 30; minimum 1. Native --interval wins.
# TEMPOD_INTERVAL=30

# Native metrics retention days: literal default 7; 0 keeps all samples.
# TEMPOD_RETENTION=7

# PipeWire client runtime directory: unset = /run/user/<compiled user.uid>,
# normally /run/user/1000. Distinct from daemon's own XDG_RUNTIME_DIR.
# TEMPOD_RUNTIME_DIR=/run/user/1000

# Native metric fixtures/alternate sysfs roots. Unset = Y2 path if present,
# otherwise discover the first Battery power supply / first backlight device.
# TEMPOD_BATTERY_SYSFS=/sys/class/power_supply/mt6323-battery
# TEMPOD_BACKLIGHT_SYSFS=/sys/class/backlight/mt6323-backlight
