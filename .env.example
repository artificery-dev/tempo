# Development overrides for builds, the dev CLI, and local debugging.
# Uncomment the values you want to override. Defaults are noted per option.

# Checkout used by the dev CLI. Default: discover from the working directory.
# TEMPO_REPO=/absolute/path/to/tempo

# Flutter SDK for the component being built. Default: discover its pinned SDK.
# TEMPO_FLUTTER_SDK=/absolute/path/to/flutter-sdk

# Dart executable for daemon builds. Default: daemon.toolchain_version's SDK;
# must match daemon.dart_version in config.yaml (currently 3.13.2).
# TEMPO_DAEMON_DART=/absolute/path/to/daemon-dart-sdk/bin/dart

# Base for ~/ public-key paths in config. Default: the developer's home.
# TEMPO_CONFIG_HOME=/absolute/path/to/developer-home

# Device SSH host. Default: networking.usb_gadget.address, without the CIDR suffix.
# TEMPO_DEVICE_HOST=10.42.0.1

# Device SSH account. Default: user.name in config.yaml.
# TEMPO_DEVICE_USER=tempo

# Host interface for dev device link commands. Default: automatic discovery.
# TEMPO_DEVICE_IFACE=usb0

# Replace the dev CLI's SSH options. Default options are shown below.
# Parsed on whitespace; ServerAliveInterval=5 and ServerAliveCountMax=3 are added.
# TEMPO_SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10"

# Build/stage rootfs directly on the host instead of Podman. Default: unset.
# Set to 1 to use installed host build tools.
# TEMPO_ROOTFS_HOST=1

# USB helper executable. Default: bundled helper, then build/toolbox/rust/release.
# TEMPO_USB_ENGINE=/absolute/path/to/tempo-usb

# USB download agent. Default: bundled DA.img, then platform/firmware/DA.img.
# TEMPO_USB_AGENT=/absolute/path/to/DA.img

# Launch Toolbox as the emulator. Default: unset; set to 1 for local runs.
# For compiled builds use --dart-define=TEMPO_TOOLBOX_EMULATOR=true instead.
# `toolbox dev emulator run` supplies both automatically.
# TEMPO_TOOLBOX_EMULATOR=1

# VM service URL used by emulator MCP. Default: discover from its URL/log files.
# TEMPO_EMULATOR_VM_URL=http://127.0.0.1:12345/SESSION_TOKEN/

# Emulator VM service URL file. Default: ~/.cache/tempo/emulator-vm.url.
# TEMPO_EMULATOR_VM_FILE=/absolute/path/to/emulator-vm.url

# Emulator log consulted by MCP. Default: ~/.cache/tempo/emulator.log.
# TEMPO_EMULATOR_LOG=/absolute/path/to/emulator.log

# Compiled host daemon to exercise in subprocess tests. Default: run Dart source.
# TEMPOD_TEST_EXECUTABLE=/absolute/path/to/host/tempod

# Native broker for integration tests. Default: skip those tests when unset.
# TEMPOD_TEST_NATIVE_EXECUTABLE=/absolute/path/to/host/tempod-native

# Native library for FFI tests. Default: supplied by daemon test tooling when
# available; otherwise those tests are skipped.
# TEMPOD_TEST_NATIVE_LIBRARY=/absolute/path/to/host/libtempod_native.so
