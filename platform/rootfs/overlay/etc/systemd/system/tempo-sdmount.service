[Unit]
Description=Auto-mount the microSD at /mnt/sd (synchronous)
# Bound to the SD partition device: appears -> mount, disappears (removal) ->
# ExecStop unmounts. Started by udev (SYSTEMD_WANTS in
# 99-tempo-sd-automount.rules), which also replays at boot coldplug so a card
# present at boot is mounted.
BindsTo=dev-mmcblk1p1.device
After=dev-mmcblk1p1.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/tempo-system/tempo-system sdmount
# A requested eject already performed a normal unmount. Missing mount is OK.
ExecStop=-/bin/umount -l /mnt/sd
