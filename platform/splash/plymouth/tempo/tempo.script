# tempo - plymouth theme for the Innioasis Y2 (480x360 RGB565 panel).
#
# Deliberately the same picture as the LK boot logo (src/boot-logo/boot-logo.png,
# flashed with scripts/boot-logo): the Debian swirl, 200px tall, dead centre on
# black. plymouth takes over from LK without the logo moving; all that changes is
# a ring of dots that fades in and starts orbiting.
#
# Everything is animated from tiny sprites rather than pre-rendered frames -
# MT6582 pushes the framebuffer over DSI with no compositing help, so a
# full-screen blit at 50Hz is not affordable but 16 nine-pixel dots are.
#
# Images are generated by src/boot-logo/mk-assets.

# ---------------------------------------------------------------- parameters

REFRESH_HZ = 50;            # plymouth's script refresh rate
DOT_COUNT = 16;             # dots around the ring
TAIL_STEPS = 6;             # pre-scaled dot sizes used for the comet tail
RING_RADIUS = 132;          # 180 +/- 132 leaves 48px clear top and bottom
REVOLUTION_SECONDS = 1.6;   # time for the comet head to go once around
RING_FADE_IN_SECONDS = 0.6; # hold the bare logo this long, as LK left it
RING_FADE_OUT_SECONDS = 0.5;# the hand-off outro: comet spins down to nothing
BREATHE_HZ = 0.25;          # slow pulse on the swirl
LOGO_MIN_OPACITY = 0.9;
BAR_WIDTH = 200;            # update-mode progress bar, centred under the swirl
BAR_HEIGHT = 6;
BAR_TRACK_OPACITY = 0.25;   # the unfilled track, against the filled part at 1
BAR_FADE_IN_SECONDS = 0.3;  # after the ring has spun down

TEXT_R = 0.72;
TEXT_G = 0.72;
TEXT_B = 0.72;

# ------------------------------------------------------------------- window

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen.x = Window.GetX();
screen.y = Window.GetY();
screen.width = Window.GetWidth();
screen.height = Window.GetHeight();
screen.cx = screen.x + screen.width / 2;
screen.cy = screen.y + screen.height / 2;

# Never let the ring run off a panel smaller than the one this was drawn for.
ring.radius = Math.Min(RING_RADIUS, Math.Min(screen.width, screen.height) / 2 - 16);

# --------------------------------------------------------------------- logo

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(screen.cx - logo.image.GetWidth() / 2,
                        screen.cy - logo.image.GetHeight() / 2,
                        10);
logo.sprite.SetOpacity(1);

# Anchor for anything drawn under the swirl (prompts, bullets, entry text).
below_logo = screen.cy + logo.image.GetHeight() / 2;

# ----------------------------------------------------------------- throbber

dot.image = Image("dot.png");

# Pre-scale the dot once per tail step; the refresh callback only swaps between
# these, it never scales.
for (s = 0; s < TAIL_STEPS; s++)
  {
    dot_scale = 0.5 + 0.5 * (s + 1) / TAIL_STEPS;
    dot.scaled[s] = dot.image.Scale(Math.Int(dot.image.GetWidth() * dot_scale + 0.5),
                                    Math.Int(dot.image.GetHeight() * dot_scale + 0.5));
    dot.w[s] = dot.scaled[s].GetWidth();
    dot.h[s] = dot.scaled[s].GetHeight();
  }

for (d = 0; d < DOT_COUNT; d++)
  {
    dot_angle = 2 * Math.Pi * d / DOT_COUNT - Math.Pi / 2;
    ring.cx[d] = screen.cx + ring.radius * Math.Cos(dot_angle);
    ring.cy[d] = screen.cy + ring.radius * Math.Sin(dot_angle);
    ring.step[d] = -1;
    ring.sprite[d] = Sprite();
    ring.sprite[d].SetOpacity(0);
  }

# ------------------------------------------------------------- progress bar
#
# Update mode: `plymouth update --status=tempo-update` swaps the ring for a
# progress bar under the swirl, `plymouth system-update --progress=<0-100>`
# fills it, and `plymouth update --status=tempo-update-done` brings the ring
# back. The bar is one white pixel image scaled to size, so it costs nothing to
# redraw. A message for the bar (`plymouth display-message --text=...`) shows
# at the bottom as usual.

bar.image = Image("bar.png");
bar.left = screen.cx - BAR_WIDTH / 2;
bar.top = below_logo + 22;
bar.track = Sprite(bar.image.Scale(BAR_WIDTH, BAR_HEIGHT));
bar.track.SetPosition(bar.left, bar.top, 30);
bar.track.SetOpacity(0);
bar.fill = Sprite();
bar.fill.SetOpacity(0);
bar.progress = 0;           # 0..1, from the last system-update message
bar.shown_width = -1;

fun place_bar (progress, alpha)
  {
    width = Math.Int(BAR_WIDTH * progress + 0.5);
    if (width > BAR_WIDTH)
      width = BAR_WIDTH;
    if (width != bar.shown_width)
      {
        if (width > 0)
          {
            bar.fill.SetImage(bar.image.Scale(width, BAR_HEIGHT));
            bar.fill.SetPosition(bar.left, bar.top, 31);
          }
        bar.shown_width = width;
      }
    bar.track.SetOpacity(BAR_TRACK_OPACITY * alpha);
    if (width > 0)
      bar.fill.SetOpacity(alpha);
    else
      bar.fill.SetOpacity(0);
  }

fun hide_bar ()
  {
    bar.track.SetOpacity(0);
    bar.fill.SetOpacity(0);
  }

# ------------------------------------------------------------------ refresh

state.name = "normal";
state.ticks = 0;
state.ring_tick = 0;        # when the ring last began fading in

fun place_dot (which, step, alpha)
  {
    # Only re-seat the sprite when it changes size - SetImage/SetPosition each
    # damage a region, SetOpacity on its own does not move anything.
    if (ring.step[which] != step)
      {
        ring.sprite[which].SetImage(dot.scaled[step]);
        ring.sprite[which].SetPosition(ring.cx[which] - dot.w[step] / 2,
                                       ring.cy[which] - dot.h[step] / 2,
                                       20);
        ring.step[which] = step;
      }
    ring.sprite[which].SetOpacity(alpha);
  }

fun hide_ring ()
  {
    for (h = 0; h < DOT_COUNT; h++)
      ring.sprite[h].SetOpacity(0);
  }

# One revolution of the comet at the given overall opacity. t is 1 at the head
# of the comet, falling to 0 just behind it.
fun spin_ring (seconds, fade)
  {
    if (fade <= 0)
      {
        hide_ring();
      }
    else
      {
        phase = seconds / REVOLUTION_SECONDS;
        phase -= Math.Int(phase);
        for (n = 0; n < DOT_COUNT; n++)
          {
            t = n / DOT_COUNT - phase;
            if (t < 0)
              t += 1;
            step = Math.Int(t * TAIL_STEPS);
            if (step > TAIL_STEPS - 1)
              step = TAIL_STEPS - 1;
            place_dot(n, step, t * t * t * fade);
          }
      }
  }

fun refresh_callback ()
  {
    state.ticks++;
    seconds = state.ticks / REFRESH_HZ;

    if (state.name == "handoff")
      {
        # The hand-off outro, played as Tempo launches: the swirl goes to
        # full opacity and the comet keeps spinning but fades out over
        # RING_FADE_OUT_SECONDS - the mirror of the fade-in - so the frame
        # the launcher then freezes on (with `plymouth deactivate`) is the
        # bare logo: the same picture Tempo draws first, and LK drew. The
        # launcher waits out this fade before freezing, so it is seen.
        logo.sprite.SetOpacity(1);

        out = (state.ticks - state.handoff_tick) / REFRESH_HZ;
        spin_ring(seconds, 1 - out / RING_FADE_OUT_SECONDS);
      }
    else
      {
        # Breathe the swirl. Starts at full opacity, so the first frame
        # plymouth draws is identical to the logo LK left on screen.
        breath = (Math.Cos(2 * Math.Pi * BREATHE_HZ * seconds) + 1) / 2;
        logo.sprite.SetOpacity(LOGO_MIN_OPACITY + (1 - LOGO_MIN_OPACITY) * breath);

        if (state.name == "normal")
          {
            since = (state.ticks - state.ring_tick) / REFRESH_HZ;
            spin_ring(seconds, Math.Min(1, since / RING_FADE_IN_SECONDS));
          }
        else if (state.name == "update")
          {
            # The ring spins down exactly as in the outro, then the bar
            # fades in where the ring's lower arc was.
            out = (state.ticks - state.update_tick) / REFRESH_HZ;
            spin_ring(seconds, 1 - out / RING_FADE_OUT_SECONDS);
            alpha = (out - RING_FADE_OUT_SECONDS) / BAR_FADE_IN_SECONDS;
            if (alpha > 0)
              place_bar(bar.progress, Math.Min(1, alpha));
          }
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);

# The launcher calls `plymouth update --status=tempo-handoff` just before it
# deactivates the splash, to settle the throbber off and leave the bare swirl
# as the frozen hand-off frame. Any other status is ignored.

fun update_status_callback (status)
  {
    # Enter the outro once, marking the tick it began so the fade above can
    # measure from there; a repeated status must not restart the fade.
    if (status == "tempo-handoff" && state.name != "handoff")
      {
        if (state.name == "update")
          {
            # The ring is already gone: drop the bar and land straight on the
            # bare swirl, with the outro's fade counted as finished.
            hide_bar();
            state.handoff_tick = state.ticks - RING_FADE_OUT_SECONDS * REFRESH_HZ - 1;
          }
        else
          state.handoff_tick = state.ticks;
        state.name = "handoff";
      }
    else if (status == "tempo-update" && state.name == "normal")
      {
        state.name = "update";
        state.update_tick = state.ticks;
        bar.progress = 0;
      }
    else if (status == "tempo-update-done" && state.name == "update")
      {
        hide_bar();
        state.name = "normal";
        state.ring_tick = state.ticks;
      }
  }

Plymouth.SetUpdateStatusFunction(update_status_callback);

# `plymouth system-update --progress=<0-100>` fills the bar. Only drawn while
# in update mode; the value is kept either way so a bar entered late is right.
fun system_update_callback (progress)
  {
    bar.progress = progress / 100;
    if (bar.progress > 1)
      bar.progress = 1;
    if (bar.progress < 0)
      bar.progress = 0;
  }

Plymouth.SetSystemUpdateFunction(system_update_callback);

# --------------------------------------------------------------------- text
#
# `label` and `bullet` below have to exist before any callback touches them:
# in plymouth script an assignment inside a function creates a *local* unless
# the name already resolves to a global, so building these hashes lazily inside
# the callbacks silently throws the sprites away when the function returns.

label = [];
bullet = [];

fun set_text (slot, text, y)
  {
    label[slot].sprite = NULL;
    if (text != "")
      {
        label[slot].image = Image.Text(text, TEXT_R, TEXT_G, TEXT_B, 1);
        if (label[slot].image)
          {
            label[slot].sprite = Sprite(label[slot].image);
            label[slot].sprite.SetPosition(
                screen.cx - label[slot].image.GetWidth() / 2, y, 100);
          }
      }
  }

fun display_message_callback (text)
  {
    set_text("message", text, screen.y + screen.height - 34);
  }

fun hide_message_callback (text)
  {
    set_text("message", "", 0);
  }

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

# ------------------------------------------------------- password / question
#
# The Y2 rootfs is not encrypted, so this path normally never runs - but a theme
# that cannot prompt turns any unexpected prompt into an unexplained hang, so it
# is wired up anyway. Bullets reuse the throbber dot at full size.

fun show_bullets (count)
  {
    spacing = dot.image.GetWidth() + 6;
    left = screen.cx - (count - 1) * spacing / 2;
    for (b = 0; bullet[b] || b < count; b++)
      {
        if (b < count)
          {
            if (!bullet[b])
              bullet[b] = Sprite(dot.image);
            bullet[b].SetPosition(left + b * spacing - dot.image.GetWidth() / 2,
                                  below_logo + 34, 100);
            bullet[b].SetOpacity(1);
          }
        else
          {
            bullet[b].SetOpacity(0);
          }
      }
  }

fun display_password_callback (prompt, bullets)
  {
    state.name = "password";
    hide_ring();
    hide_bar();
    set_text("prompt", prompt, below_logo + 8);
    show_bullets(bullets);
  }

fun display_question_callback (prompt, entry)
  {
    state.name = "question";
    hide_ring();
    hide_bar();
    set_text("prompt", prompt, below_logo + 8);
    set_text("entry", entry, below_logo + 34);
  }

fun display_normal_callback ()
  {
    state.name = "normal";
    state.ring_tick = state.ticks;
    set_text("prompt", "", 0);
    set_text("entry", "", 0);
    show_bullets(0);
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);

# --------------------------------------------------------------------- quit
#
# Leave the swirl on screen at full opacity as we hand over, so the last thing
# plymouth draws matches the first thing it drew - and matches the LK logo.

fun quit_callback ()
  {
    hide_ring();
    hide_bar();
    show_bullets(0);
    set_text("message", "", 0);
    set_text("prompt", "", 0);
    set_text("entry", "", 0);
    logo.sprite.SetOpacity(1);
  }

Plymouth.SetQuitFunction(quit_callback);
