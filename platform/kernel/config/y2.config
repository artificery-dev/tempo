# Y2 first-boot kernel config fragment (merged onto multi_v7_defconfig).
# Goal: reach an on-screen console via simple-framebuffer + fbcon, with the
# MediaTek UART and timer, on the mt6582 - no clock/pinctrl drivers needed yet.

CONFIG_ARCH_MEDIATEK=y

# MediaTek UART (ttyS0) + timer
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_MTK_TIMER=y

# On-screen console + KMS. simpledrm wraps the LK-inherited "simple-framebuffer"
# node as a DRM/KMS device (card0, single fixed mode) so flutter-pi/GBM can
# modeset and lima+kmsro can present through it; fbcon rides on DRM fbdev
# emulation. No simpledrm/simplefb: LK's live scanout keeps the boot logo on
# screen untouched until mtk-drm's first modeset parks it and takes over.
CONFIG_FB=y
# CONFIG_FB_SIMPLE is not set
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y

# Built-in initramfs (no bootloader/initrd needed) + devtmpfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="@ROOT@/platform/rootfs/initramfs/initramfs.list"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Direct boot from MediaTek LK (no u-boot): appended DTB + forced cmdline so we
# don't depend on whatever cmdline/atags LK passes. console=tty0 -> fbcon on the
# inherited LK framebuffer (simple-framebuffer).
CONFIG_ARM_APPENDED_DTB=y
# Do NOT merge LK's atags into the appended DTB - we force our own cmdline and
# a bad atag merge would corrupt the DTB (hangs setup_machine_fdt).
# CONFIG_ARM_ATAG_DTB_COMPAT is not set
# tty0 (fbcon) LAST so /dev/console -> fbcon: userspace /init output lands on
# the screen, not the (unwired, silent) serial port. All console= still get
# kernel printk; only /dev/console for userspace uses the last one.
# Tempo packages install a standard MBR at USER sector zero. Partition 1 is
# the ext4 root filesystem at 0x5180000, extending to the end of USER.
# Vendor boot-chain structures below it remain at their existing offsets.
# Smooth-boot profile: quiet + splash bring up plymouth (systemd-started from
# the rootfs); plymouth.ignore-serial-consoles keeps the ttyS0 entry from
# forcing plymouth into text/details mode; drm_kms_helper.fbdev_emulation=0
# stops fbcon from performing the first modeset, so LK's logo keeps scanning
# until plymouth takes the display over with the identical swirl. Console
# access remains on serial (ttyS0/ttyGS0/ttyACM0) and ssh. For a dev console
# on the panel, drop the fbdev_emulation=0 and quiet/splash pieces.
CONFIG_CMDLINE="console=ttyS0,921600n8 quiet splash plymouth.ignore-serial-consoles drm_kms_helper.fbdev_emulation=0 rootwait clk_ignore_unused"
CONFIG_CMDLINE_FORCE=y
CONFIG_MSDOS_PARTITION=y
# CONFIG_CMDLINE_PARTITION is not set

# Helpful early visibility
CONFIG_PRINTK=y
CONFIG_EARLYPRINTK=y

# Keep the kernel small. The budget is the BOOTIMG partition: 16 MiB
# (0x1000000, linear 0x3180000..0x4180000 in the scatter), holding the
# zImage + dtb, the initramfs with the splash payload, and the MTK/Android
# headers and 2 KiB page padding; bootImage in packages/tempo_build/lib/src/kernel.dart
# refuses an image that does not fit. A stock multi_v7 kernel alone is ~12 MB and the
# stock vendor kernel ~4.7 MB, so everything not needed on this device stays
# off. The image is ~12.4 MiB today.
# Networking core: systemd (PID 1 in Debian) requires AF_UNIX sockets, so NET
# must be on even with no NIC. Keep INET too (userspace assumes it). Actual
# network device drivers stay off (NETDEVICES/WIRELESS/ETHERNET disabled below).
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
# Userspace VPN support.  TUN provides /dev/net/tun; WireGuard is built in so
# the installed Debian rootfs does not need a matching modules tree.
CONFIG_TUN=y
CONFIG_WIREGUARD=y
CONFIG_NET_CORE=y
# There is no known discrete TPM on the Y2, but expose the standard kernel TPM
# core and /dev/vtpmx so a TPM 2.0 implemented by swtpm can be attached later.
CONFIG_TCG_TPM=y
CONFIG_TCG_VTPM_PROXY=y
# CONFIG_TCG_TIS_I2C_INFINEON is not set
# GPU: ARM Mali-400 MP2 via the mainline lima driver (render-only DRM; present
# still goes through the simple-framebuffer, no KMS driver). The MFG MTCMOS
# power domain + clock gate are brought up by our mt6582-mfg-power genpd shim;
# lima's runtime PM drives it. Keep SIMPLEDRM off so FB_SIMPLE keeps /dev/fb0.
CONFIG_DRM=y
CONFIG_DRM_LIMA=y
CONFIG_MTK_MT6582_MFG_POWER=y
# Stock boot-time SPM normal-mode firmware. This keeps the always-on source
# clock/thermal handshakes running; suspend and deep idle are not enabled yet.
CONFIG_MTK_MT6582_SPM=y
# Real MT6582 clock driver (CCF): apmixedsys PLLs + topckgen muxes + infracfg +
# pericfg gates (clk-mt6582), plus the mmsys DISP gates (clk-mt6582-mm) needed
# for the DISP/KMS bring-up. Replaces the per-subsystem fixed-clock fakes as
# consumers are migrated. Booted with clk_ignore_unused (see CMDLINE) until the
# critical-clock set is validated, so nothing LK left on gets gated off.
CONFIG_COMMON_CLK_MT6582=y
CONFIG_COMMON_CLK_MT6582_MMSYS=y
# MT6323 PMIC poweroff handler: sets pm_power_off so `poweroff`/systemd shutdown
# actually cut power instead of hanging at the final step. Needs the mt6323-pwrc
# DT node (added under the MFD).
CONFIG_POWER_RESET_MT6323=y
# USB serial gadget console: MUSB peripheral + MT6582 USB2 PHY + g_serial.
# The mainline "mediatek,mtk-musb" glue drives the MUSB core; our new
# phy-mtk-u2-mt6582 does the PHY init; g_serial gives /dev/ttyGS0.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_MTK_U2_MT6582=y
CONFIG_USB_PHY=y
CONFIG_NOP_USB_XCEIV=y
# CDC Composite gadget = CDC-ACM (serial console, /dev/ttyGS0) + CDC-ECM
# (ethernet, usb0) in one builtin gadget, so we keep the serial login AND get
# USB networking to the host.
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_CDC_COMPOSITE=y
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_MTD is not set
# NETDEVICES itself must be on: it also gates SO_BINDTOIFINDEX in the socket
# core, which systemd-resolved's stub listener and networkd's DHCP server need
# (without it both fail with "Protocol not available"). Every driver family
# under it stays off, so this costs almost nothing; the gadget link is
# USB_U_ETHER above, not a NETDEVICES driver.
CONFIG_NETDEVICES=y
# CONFIG_ETHERNET is not set
# CONFIG_PHYLIB is not set
# CONFIG_MDIO_DEVICE is not set
# CONFIG_USB_NET_DRIVERS is not set
# MT6582 full-MAC WLAN uses cfg80211 for station scan/association and retains
# the vendor driver's Wireless Extensions compatibility while its Linux glue
# is brought forward.  The driver itself is built in by the CONSYS patch set.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
# CONFIG_MAC80211 is not set
CONFIG_WLAN=y
CONFIG_MTK_CONSYS_WIFI=y
# CONFIG_PPP is not set
# CONFIG_SLIP is not set
# CONFIG_NET_FAILOVER is not set

# Firewall. ufw drives iptables-nft, so this is nf_tables plus the xtables
# matches and targets ufw's rule set reaches through nft_compat (conntrack
# state, limit, recent, addrtype, hl, comment, LOG, REJECT), for both
# families since ufw enables IPv6 by default. Built in: the rootfs installs no
# modules. ufw.service has a drop-in that skips it on a kernel without
# /proc/net/netfilter, so an image on an older kernel still boots clean.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_NAT=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y
# ufw's before6.rules drops RH0 routing headers with the rt match.
CONFIG_IP6_NF_MATCH_RT=y
# CONFIG_BT is not set
# eMMC/SD via mainline mtk-sd (msdc0=eMMC/mmcblk0, msdc1=uSD/mmcblk1). Needed
# to reach an on-disk rootfs. pinctrl is patched optional in mtk-sd.c (no
# mainline mt6582 pinctrl; LK muxes the eMMC pins).
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
# Real rootfs is ext4 on mmcblk0p1, the one partition in Tempo's MBR (see
# docs/platform/boot-and-flashing.md); the initramfs mounts it and switch_roots.
# The loop device stays for image work at a shell.
CONFIG_EXT4_FS=y
# security.* xattrs on ext4 - which is where file capabilities live. Without
# this handler the kernel cannot see the cap_net_raw that Debian's iputils-ping
# postinst puts on /bin/ping (setcap on the device: "Operation not supported"),
# nor any other package's file capability. multi_v7_defconfig leaves it off.
CONFIG_EXT4_FS_SECURITY=y
# POSIX ACLs on the rootfs: systemd-tmpfiles' a+ entries (journal directories
# readable by adm/wheel) and logind's uaccess ACLs on device nodes want them;
# without the handler every boot logs "Failed to set ACL" and setfacl fails.
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_BLK_DEV_LOOP=y
# Read the microSD (mmcblk1, vfat) as a transfer medium for the rootfs image.
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MISC is not set
# Audio: ALSA + ASoC. The MT6582 AFE (DL1 memif -> I2S out) drives the Y2's
# CS43131 DAC over I2S, with the AW87559 speaker amplifier behind it; the
# mt6582-cs43131 machine driver ties them into one card. Nothing else from the
# defconfig's sound tree is wanted (USB/HDA/PCI audio, the other SoCs' ASoC).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_DYNAMIC_MINORS=y
# CONFIG_SND_SUPPORT_OLD_API is not set
# CONFIG_SND_DRIVERS is not set
# CONFIG_SND_PCI is not set
# CONFIG_SND_SPI is not set
# CONFIG_SND_USB is not set
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MEDIATEK=y
CONFIG_SND_SOC_MT6582=y
CONFIG_SND_SOC_MT6582_CS43131=y
CONFIG_SND_SOC_CS43130=y
CONFIG_SND_SOC_AW87559=y
# CONFIG_SND_SOC_MT2701 is not set
# CONFIG_SND_SOC_MT8173 is not set
# CONFIG_SND_SOC_MT6797 is not set
# CONFIG_SND_SOC_MT7986 is not set
# CONFIG_SND_SOC_MT8183 is not set
# CONFIG_SND_SOC_MT8186 is not set
# CONFIG_SND_SOC_MT8188 is not set
# CONFIG_SND_SOC_MT8192 is not set
# CONFIG_SND_SOC_MT8195 is not set
# CONFIG_SND_SOC_MT8365 is not set
# CONFIG_SND_HDA_INTEL is not set
# CONFIG_SND_HDA_TEGRA is not set
# CONFIG_SND_SIMPLE_CARD is not set
# CONFIG_SND_AUDIO_GRAPH_CARD is not set
# CONFIG_HID is not set
# I2C: needed for the click-wheel controller (APT32F @ i2c0 0x51) and audio.
# i2c-mt65xx drives the MT6582 controllers; CHARDEV gives /dev/i2c-N for i2c-tools
# (used to reverse-engineer the wheel).
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MT65XX=y

# Side volume keys: small IRQ-driven MT6582 keypad-matrix driver (KP_MEM1 bit0/1).
CONFIG_KEYBOARD_MT6582=y
# CONFIG_SPI is not set
# GPIO + EINT (external interrupts) for the MT6582. Reuses the mainline mtk-eint
# irqchip library (EINT regs are register-identical to mtk_generic_eint_regs).
# Provides wakeup-capable interrupts + GPIO in/out; needed for the click-wheel
# nav buttons (gpio-keys on GPIO 6/7/9/10/54) and the wheel data-ready line
# (GPIO 55). CONFIG_KEYBOARD_GPIO gives gpio-keys.
CONFIG_GPIO_MT6582=y
CONFIG_EINT_MTK=y
CONFIG_KEYBOARD_GPIO=y
# Click-wheel rotation/scroll: APT32F i2c client, reads the frame on the wheel's
# data-ready EINT (GPIO 55) and reports scroll as key events.
CONFIG_INPUT_MISC=y
# uinput: virtual input devices, so tooling can drive the wheel/buttons
# remotely (input tests over ssh without hands on the device).
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_APT32F_WHEEL=y

# PMIC + charging: pwrap (PMIC bus, mt6582 variant) + the MT6323 charger driver
# (regmap child of pwrap; hardware CC/CV). Lets the device charge instead of
# only draining. No mt6397 MFD/EINT needed for charging.
CONFIG_POWER_SUPPLY=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_CHARGER_MT6323=y

# MT6323 PMIC as an mt6397 MFD, hung off EINT 25 (the PMIC's dedicated interrupt
# line, not the storming pwrap wrapper IRQ). Unlocks the power key (mtk-pmic-keys,
# wakeup-capable) and the RTC + alarms. The regulator/led/codec sub-devices are
# spawned too but stay dormant (their drivers are off). Coexists with our
# regmap-direct charger on the shared pwrap regmap.
CONFIG_MFD_MT6397=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_MT6397=y
# LCD backlight: the four MT6323 ISINK channels ganged as one backlight-class
# device (mt6323-backlight, a pwrap regmap child). /sys/class/backlight -> on/off.
CONFIG_BACKLIGHT_MT6323=y

# Regulators: needed so the eMMC has a vmmc-supply. Without it the mmc host's
# ocr_avail is 0 and card init fails with "no support for card's volts" (-EINVAL).
# A fixed-voltage regulator is enough (no PMIC driver yet).
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# The MT6323's own rails (mt6323-regulator, an mt6397 MFD cell). Only rails
# named in the DTS get constraints; the rest stay as LK left them. First user:
# VGP2, the CS43131 DAC's 1.8 V analog rail.
CONFIG_REGULATOR_MT6323=y
# The vibration motor: the MT6323's VIBR rail as a force-feedback input
# device (regulator-haptic + ff-memless), rumbled by tempod for clicks.
CONFIG_INPUT_REGULATOR_HAPTIC=y
CONFIG_INPUT_FF_MEMLESS=y
# CONFIG_CRYPTO_HW is not set
# CONFIG_ETHERNET is not set
# CONFIG_IIO is not set
# CONFIG_PWM is not set
# RTC_CLASS is enabled above (mt6323 RTC via the MFD).
# CONFIG_DMADEVICES is not set
# CONFIG_SUSPEND is not set
# CONFIG_PM is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set

# Full 992 MB DRAM (memory node is 0x80000000+0x3e000000). That is past the
# ~760 MB ARM lowmem window at the default 3G/1G split, so the RAM above lowmem
# must be managed as highmem. HIGHPTE keeps userspace page tables up there too.
CONFIG_HIGHMEM=y
CONFIG_HIGHPTE=y

# DISP/KMS bring-up (WIP): GC9503V DSI panel driver (init sequence RE'd from the
# vendor LK). Needs DRM_MIPI_DSI + panel infra; the mtk-drm DSI host + mmsys/ovl/
# rdma/dsi mt6582 support come next. See docs/porting/display.md.
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_GC9503V=y

# DISP/KMS (WIP): mtk-drm DDP pipeline for MT6582 (mt2701-reuse components +
# mt8173-reuse mipi-tx). Not wired in DT yet (needs mmsys/ovl/rdma/color/mutex/
# dsi nodes + M4U/SMI/larb + port graph), so this compiles the driver support
# but does not probe until the DT lands. See docs/porting/display.md.
CONFIG_MTK_MMSYS=y
CONFIG_MTK_SMI=y
CONFIG_DRM_MEDIATEK=y
# Generic shadow fbdev (drm_fbdev_ttm) for mtk's custom GEM -> fbcon + /dev/fb1.
CONFIG_DRM_TTM=y
CONFIG_DRM_TTM_HELPER=y
CONFIG_DRM_MEDIATEK_DSI=y
CONFIG_PHY_MTK_MIPI_DSI=y
# CMA for mtk-drm framebuffers (no IOMMU on mt6582 -> gem uses dma_alloc/CMA).
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=16
# DISP debug: allow /dev/mem MMIO reads (mtk-drm register inspection) during bring-up.
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
# Fast kernel iteration: kexec (boot a new kernel from RAM without the bootloader).
CONFIG_KEXEC=y

# What systemd wants from a kernel beyond the bare minimum multi_v7 gives it
# (systemd's README, "REQUIREMENTS"). None of these is needed to boot; they
# turn silently-ignored unit directives into working ones, and the sizes are
# small next to the 16 MiB budget above.
# Namespaces: PrivateTmp=, ProtectSystem=, PrivateNetwork=, RestrictNamespaces=
# and friends, which most of Debian's units carry (resolved, networkd, avahi).
# Without CONFIG_NAMESPACES systemd skips the sandbox and says nothing.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
# cgroup v2 controllers systemd drives: TasksMax= (pids), and the BPF programs
# behind DeviceAllow=/DevicePolicy= and IPAddressAllow= on the unified
# hierarchy - on v2 device access control is BPF, not the old devices cgroup.
CONFIG_CGROUP_PIDS=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
# The running kernel's configuration at /proc/config.gz, so a device can be
# checked against this fragment without trusting a build log.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Modules stay enabled even though the rootfs installs none: with MODULES off,
# olddefconfig promotes every =m in multi_v7_defconfig to =y instead of
# dropping it, and the zImage grew by 2.7 MB (boot.img 15.6 of 16 MiB) when
# that was tried. The =m leftovers (CRYPTO_USER_API_*, USB_CONFIGFS,
# USB_F_MASS_STORAGE, CRYPTO_*_ARM) are simply absent on the device. Turning
# MODULES off is part of the kernel-diet pass, once the modular set is
# explicitly disabled.
# Timer tick at 1 kHz. multi_v7 runs at 100 Hz, where a jiffy is 10 ms - and
# a single PMIC access through pwrap costs almost exactly that (a backlight
# write ~385 ms for ~40 accesses; see TASKS.md), which points at
# pwrap_wait_for_state's jiffies-based timeout being what every access waits
# out. At 1 kHz that wait is 1 ms; if the PMIC path gets ten times faster
# the diagnosis is confirmed and the screen fade comes back, and if it does
# not, the tick is still the right one for a media player's audio latency.
# CONFIG_HZ_100 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# Bluetooth. The kernel HCI core + L2CAP/SCO for BlueZ, RFCOMM for the
# serial-port profiles (HFP/HSP need it, A2DP does not). The controller is
# the MT6582's on-SoC CONSYS, reached through its BTIF link and the WMT/STP
# stack (drivers/misc/mediatek-consys, patch 0020), which registers an hci
# device; no UART/USB HCI transport drivers are needed.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_LE=y
# CONFIG_BT_HCIBTUSB is not set
# CONFIG_BT_HCIUART is not set
# CONFIG_BT_HIDP is not set
# CONFIG_BT_BNEP is not set
# CONFIG_BT_LE_L2CAP_ECRED is not set
# The CONSYS stack itself (patch 0020): BTIF + WMT/STP, BT function.
CONFIG_MTK_CONSYS=y
CONFIG_MTK_CONSYS_BT=y
# The raw vendor node too, so the stock HCI sequence can be replayed by hand.
CONFIG_MTK_CONSYS_BT_CHRDEV=y
# MT6627 FM control and RDS over the FM STP channel.
CONFIG_MTK_CONSYS_FM=y
# The CONSYS firmware, built into the kernel so a reflash is self-contained:
# the two WMT patch images (E1 revision variants, the chip-detected one is
# used), WiFi RAM code, WMT_SOC.cfg, and the MT6627 FM ROMv1 DSP patch,
# coefficients, and board tuning. From the stock ROM's /system/etc/firmware
# (references/vendor-firmware in the y2 repo).
CONFIG_EXTRA_FIRMWARE="mediatek/mt6582/mt6572_82_patch_e1_0_hdr.bin mediatek/mt6582/mt6572_82_patch_e1_1_hdr.bin mediatek/mt6582/WIFI_RAM_CODE_MT6582 mediatek/mt6582/WMT_SOC.cfg mediatek/mt6582/mt6627/mt6627_fm_v1_patch.bin mediatek/mt6582/mt6627/mt6627_fm_v1_coeff.bin mediatek/mt6582/mt6627/mt6627_fm_cust.cfg"
CONFIG_EXTRA_FIRMWARE_DIR="@ROOT@/platform/firmware"
# The crypto BlueZ's SMP needs (LE pairing: AES-CMAC, ECDH) - "Unable to
# create CMAC crypto context" at hci0 power-on without it.
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_ECB=y
