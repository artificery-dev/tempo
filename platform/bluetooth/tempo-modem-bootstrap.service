[Unit]
Description=Initialize MT6582 radio using vendor firmware and transient state
After=local-fs.target
Before=bluetooth.service tempod-native.service tempod.service mt6582-wifi-power.service wpa_supplicant.service wpa_supplicant-nl80211@wlan0.service
AssertPathExists=/opt/tempo-modem-diag/modem_1_2g_n.img

[Service]
Type=oneshot
ExecStart=/opt/tempo-modem-diag/bootstrap /opt/tempo-modem-diag/modem_1_2g_n.img
ExecStopPost=/opt/tempo-modem-diag/bootstrap /opt/tempo-modem-diag/modem_1_2g_n.img --cleanup
TimeoutStartSec=40
TimeoutStopSec=5
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=multi-user.target
