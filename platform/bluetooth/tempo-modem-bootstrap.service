[Unit]
Description=Initialize MT6582 radio calibration and power the modem off
After=local-fs.target
Before=bluetooth.service tempod-native.service tempod.service mt6582-wifi-power.service wpa_supplicant.service wpa_supplicant-nl80211@wlan0.service
ConditionPathExists=/opt/tempo-modem-diag/fixture/manifest.json

[Service]
Type=oneshot
ExecStart=/opt/tempo-modem-diag/bootstrap /opt/tempo-modem-diag/fixture
ExecStopPost=/opt/tempo-modem-diag/bootstrap /opt/tempo-modem-diag/fixture --cleanup
TimeoutStartSec=40
TimeoutStopSec=5
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=multi-user.target
