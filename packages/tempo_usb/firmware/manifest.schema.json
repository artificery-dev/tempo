{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tempo.artificery.dev/schemas/y2-firmware-v1.json",
  "title": "Tempo Y2 firmware manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "device", "firmware", "images"],
  "properties": {
    "format": { "const": "dev.artificery.tempo.y2-firmware" },
    "format_version": { "const": 1 },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hardware_code", "hardware_subcode", "storage"],
      "properties": {
        "id": { "const": "innioasis-y2" },
        "hardware_code": { "const": 25986 },
        "hardware_subcode": { "const": 35328 },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["boot1", "boot2", "user"],
          "properties": {
            "boot1": { "const": 4194304 },
            "boot2": { "const": 4194304 },
            "user": { "const": 7818182656 }
          }
        }
      }
    },
    "firmware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "size", "sha256", "writes"],
        "properties": {
          "file": { "type": "string", "pattern": "^images/[^\\\\]+$" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "writes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "region", "source_offset", "target_offset", "length"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "region": { "enum": ["boot1", "boot2", "user"] },
                "source_offset": { "type": "integer", "minimum": 0, "multipleOf": 512 },
                "target_offset": { "type": "integer", "minimum": 0, "multipleOf": 512 },
                "length": { "type": "integer", "minimum": 512, "multipleOf": 512 }
              }
            }
          }
        }
      }
    }
  }
}
